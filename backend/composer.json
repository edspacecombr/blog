{
  "name": "professional-blog/backend",
  "description": "Backend for Professional Multilingual Blog",
  "type": "project",
  "require": {
    "php": "^8.1",
    "symfony/dotenv": "^6.3",
    "symfony/http-foundation": "^6.3",
    "symfony/routing": "^6.3",
    "firebase/jwt": "^6.8",
    "ext-pdo_pgsql": "*",
    "ext-redis": "*",
    "monolog/monolog": "^3.4",
    "vlucas/phpdotenv": "^5.5"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0",
    "phpstan/phpstan": "^1.10"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "lint": "phpstan analyse src"
  }
}

