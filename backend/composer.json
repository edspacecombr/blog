{
  "name": "professional-blog/backend",
  "description": "Backend for Professional Multilingual Blog",
  "type": "project",
  "require": {
    "php": "^8.1",
    "symfony/dotenv": "^6.3",
    "symfony/http-foundation": "^6.3",
    "symfony/routing": "^6.3",
    "lcobucci/jwt": "^5.0",
    "ext-pdo_pgsql": "*",
    "ext-redis": "*",
    "monolog/monolog": "^3.4",
    "vlucas/phpdotenv": "^5.5",
    "intervention/image": "^3.11",
    "ezyang/htmlpurifier": "^4.19"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0",
    "phpstan/phpstan": "^1.10"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "lint": "phpstan analyse src",
    "test:unit": "phpunit tests/Unit",
    "test:feature": "phpunit tests/Feature",
    "test:coverage": "phpunit --coverage-html=coverage --coverage-text=php://stdout"
  }
}
